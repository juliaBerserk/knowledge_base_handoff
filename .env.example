# Совместимо с OpenAI, OpenRouter, Groq, локальным Ollama (openai-compatible).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Без ключа система всё равно индексирует документы, извлекает структуру эвристиками
# и отвечает по релевантным фрагментам. LLM улучшает карточки знаний и формулировки ответов.
