# Скопируйте в .env и замените значения. Файл .env в git не попадает.

APP_SECRET_KEY=dev-secret-key-change-me-32chars-min
TZ=Europe/Moscow

POSTGRES_DB=estafeta
POSTGRES_PASSWORD=change_me_postgres
ESTAFETA_OWNER_PASSWORD=change_me_owner
ESTAFETA_APP_PASSWORD=change_me_app

# Приложение подключается ролью estafeta_app (не владелец таблиц).
DATABASE_URL=postgresql+psycopg://estafeta_app:change_me_app@localhost:5432/estafeta
# Миграции Alembic — только роль estafeta_owner.
DATABASE_OWNER_URL=postgresql+psycopg://estafeta_owner:change_me_owner@localhost:5432/estafeta

# Для Vite dev-сервера. В Docker за Nginx оставьте пустым.
CORS_ORIGINS=http://localhost:5173

LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=local
LLM_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3

SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Опционально, письма с приглашениями (этап 3). Если пусто — админ копирует ссылку.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
