# Скопируйте в .env и замените значения. Файл .env в git не попадает.

APP_SECRET_KEY=dev-secret-key-change-me-32chars-min
TZ=Europe/Moscow

POSTGRES_DB=estafeta
POSTGRES_PASSWORD=change_me_postgres
ESTAFETA_OWNER_PASSWORD=change_me_owner
ESTAFETA_APP_PASSWORD=change_me_app
ESTAFETA_ADMIN_PASSWORD=change_me_admin
ESTAFETA_WORKER_PASSWORD=change_me_worker

# Приложение подключается ролью estafeta_app (не владелец таблиц).
DATABASE_URL=postgresql+psycopg://estafeta_app:change_me_app@localhost:5432/estafeta
DATABASE_ADMIN_URL=postgresql+psycopg://estafeta_admin:change_me_admin@localhost:5432/estafeta
DATABASE_WORKER_URL=postgresql+psycopg://estafeta_worker:change_me_worker@localhost:5432/estafeta
# Миграции Alembic — только роль estafeta_owner.
DATABASE_OWNER_URL=postgresql+psycopg://estafeta_owner:change_me_owner@localhost:5432/estafeta

# Для Vite dev-сервера. В Docker за Nginx оставьте пустым.
CORS_ORIGINS=http://localhost:5173

LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=local
LLM_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_REVISION=
CHUNK_SIZE=900
CHUNK_OVERLAP=160
LLM_TIMEOUT_SECONDS=35
RAG_TOP_K=8
HANDOFF_RETENTION=archive

SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
AUTH_PUBLIC_ORIGIN=http://localhost:8080
# Для запуска API напрямую оставьте false. Compose включает доверие к своему Nginx.
AUTH_TRUST_PROXY_IP=false
BOOTSTRAP_ADMIN_EMAIL=

# Опционально, письма с приглашениями (этап 3). Если пусто — админ копирует ссылку.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Compose читает политику из JSON. Для настройки скопируйте шаблон в отдельный файл.
# REDACTION_POLICY_FILE=./redaction.local.json
# При локальном запуске API без контейнера укажите путь к JSON в REDACTION_POLICY_PATH.
