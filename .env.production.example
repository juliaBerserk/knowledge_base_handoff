# Скопируйте в .env.production. Значения должны поступать из хранилища секретов организации.

# HTTPS-адрес интерфейса в нижнем регистре, без завершающего слеша.
AUTH_PUBLIC_ORIGIN=
# Каталог с fullchain.pem и privkey.pem на Docker-хосте.
TLS_CERT_DIR=./tls

# Случайный стабильный секрет длиной от 32 символов.
APP_SECRET_KEY=
# Разные случайные пароли Base64URL: буквы латиницы, цифры, дефис, подчёркивание.
POSTGRES_PASSWORD=
ESTAFETA_OWNER_PASSWORD=
ESTAFETA_APP_PASSWORD=
ESTAFETA_ADMIN_PASSWORD=
ESTAFETA_WORKER_PASSWORD=

BOOTSTRAP_ADMIN_EMAIL=
# Укажите адрес и имя модели из разрешённого окружения организации.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_REVISION=

# Для доставки приглашений и ссылок восстановления.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
